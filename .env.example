# PolyglotMesh Environment Configuration Template
# Copy to .env and replace placeholder values before running locally.

# Server & API Ports
SERVER_PORT=8080
VITE_API_BASE_URL=http://localhost:8080

# PostgreSQL Database Configuration (Module H)
POSTGRES_DB=polyglotmesh
POSTGRES_USER=polyglot_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
SPRING_R2DBC_URL=r2dbc:postgresql://localhost:5432/polyglotmesh
SPRING_R2DBC_USERNAME=polyglot_user
SPRING_R2DBC_PASSWORD=CHANGE_ME_LOCAL_PASSWORD

# GraalVM Sandbox Controls (Module D)
POLYGLOT_DEFAULT_TIMEOUT_MS=3000
POLYGLOT_MAX_TIMEOUT_MS=5000
POLYGLOT_MAX_SOURCE_BYTES=65536
POLYGLOT_STATEMENT_LIMIT=100000
